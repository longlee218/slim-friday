    "TaskGet",
    "TaskStop",
    "ToolSearch",
    "ListMcpResourcesTool",
    "ReadMcpResourceTool",
    "ReadMcpResourceDirTool",
    "RefreshMcpTools",
    "WaitForMcpServers",
    "SendFeedback",
    "AskUserQuestion",
    "Agent",
    "SendMessage",
    "ListAgents",
  ],
}
