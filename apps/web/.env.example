# Copy to apps/web/.env.local for a local build; on Vercel set both in Project Settings > Environment Variables.
# The engine's public URL (the tunnel hostname). Same value as the engine's PUBLIC_API_URL.
VITE_API_URL=https://friday-api.example.com
# The R2 S3 endpoint origin the engine presigns URLs for (see docs/web-setup.md, R2).
VITE_R2_ORIGIN=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Optional: the CDN origin images are served from (same value as the engine's CDN). Leave unset if not used.
VITE_CDN_ORIGIN=https://cdn.example.com
