# Placeholder values only. Copy to .env and replace REPLACE_ME. Never commit real values.
# Anthropic path (default when no real OPENROUTER_API_KEY is set)
CLAUDE_CODE_OAUTH_TOKEN=REPLACE_ME
# OpenRouter path: a real key here selects OpenRouter even if the OAuth token is also set
OPENROUTER_API_KEY=REPLACE_ME
DISCORD_TOKEN=REPLACE_ME
OWNER_DISCORD_ID=REPLACE_ME
AGENT_HOME=/absolute/path/to/agent-home
LOG_LEVEL=info
# Optional overrides
# Force the provider (anthropic|openrouter); otherwise auto-detected from the credentials above
# LLM_PROVIDER=openrouter
# Model id. Defaults: anthropic -> claude-haiku-4-5-20251001, openrouter -> deepseek/deepseek-v4-flash
# MODEL=deepseek/deepseek-v4-flash
# Model for `task:` code tasks. Default: anthropic -> same as MODEL, openrouter -> anthropic/claude-haiku-4.5
# CODE_MODEL=anthropic/claude-haiku-4.5
# Commit identity for agent commits when a repo has no gitAuthor in repos.yaml: "Name <email>"
# GIT_AUTHOR=Your Name <you@example.com>
# MAX_TURNS=20
# MAX_BUDGET_USD=0.5   (default 0.5 on anthropic; no cap on openrouter unless set)
# TIMEOUT_MS=300000
# MAX_CONCURRENT_RUNS=3
