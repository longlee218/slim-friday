# Placeholder values only. Copy to .env and replace REPLACE_ME. Never commit real values.
# Anthropic path (default when no real OPENROUTER_API_KEY is set)
CLAUDE_CODE_OAUTH_TOKEN=REPLACE_ME
# OpenRouter path: a real key here selects OpenRouter even if the OAuth token is also set
OPENROUTER_API_KEY=REPLACE_ME
DISCORD_TOKEN=REPLACE_ME
OWNER_DISCORD_ID=REPLACE_ME
# Guild (server) id the bot serves: messages from any other guild are ignored. REQUIRED as soon as any
# workspace lists `channels:` in workspace.yaml (startup refuses without it). 17-20 digits.
DISCORD_GUILD_ID=REPLACE_ME
# Agent home: absolute path to a REAL directory OUTSIDE every git repo (no symlink into a repo, no ~).
# Startup refuses a home inside a repo or git working tree. Example: /Users/you/.friday
AGENT_HOME=/absolute/path/to/agent-home
LOG_LEVEL=info
# Optional overrides
# Force the provider (anthropic|openrouter); otherwise auto-detected from the credentials above
# LLM_PROVIDER=openrouter
# Anthropic model tiers (ids). Stages pick a tier: Q&A haiku; plan/exec sonnet, opus for class=design, haiku for mechanical exec
# MODEL_HAIKU=claude-haiku-4-5-20251001
# MODEL_SONNET=claude-sonnet-5-5
# MODEL_OPUS=claude-opus-5-5
# Pin one stage (tier name or model id): MODEL_<ROLE>_<STAGE>, e.g. MODEL_DEV_PLAN=opus, MODEL_ASSISTANT_QA=sonnet
# Budget per stage in USD: BUDGET_<ROLE>_<STAGE>_USD. Defaults: ASSISTANT_QA 0.5 (escalated 1.5), DEV_PLAN 1.5, DEV_EXEC 3.0 (worst case ~2.0 per Q&A message with escalation: 0.5 + 1.5)
# BUDGET_DEV_EXEC_USD=3
# DEPRECATED aliases (kept one release, startup warns): MODEL pins assistant qa; CODE_MODEL (else MODEL) pins dev plan AND exec (class=design then never gets Opus on plan). A qa pin disables Q&A escalation.
# On openrouter they are the only model slots (tiers are not used): defaults deepseek/deepseek-v4-flash and anthropic/claude-haiku-4.5
# MODEL=deepseek/deepseek-v4-flash
# CODE_MODEL=anthropic/claude-haiku-4.5
# Model for the manual memory compaction call (`compact memory`, `bun run memory:compact`). Default: anthropic -> the haiku tier (MODEL_HAIKU), openrouter -> anthropic/claude-haiku-4.5
# MEMORY_MODEL=claude-haiku-4-5-20251001
# Commit identity for agent commits when a repo has no gitAuthor in repos.yaml: "Name <email>"
# GIT_AUTHOR=Your Name <you@example.com>
# MAX_TURNS=20
# MAX_BUDGET_USD=   optional global cap = min(stage budget, cap); unset = stage budgets only (openrouter: no cap)
# TIMEOUT_MS=300000
# MAX_CONCURRENT_RUNS=3
