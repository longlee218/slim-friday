# Placeholder values only. Copy to .env and replace REPLACE_ME. Never commit real values.
CLAUDE_CODE_OAUTH_TOKEN=REPLACE_ME
DISCORD_TOKEN=REPLACE_ME
OWNER_DISCORD_ID=REPLACE_ME
# Guild (server) id the bot serves: messages from any other guild are ignored. REQUIRED as soon as any
# workspace lists `channels:` in workspace.yaml (startup refuses without it). 17-20 digits.
DISCORD_GUILD_ID=REPLACE_ME
# Agent home: absolute path to a REAL directory OUTSIDE every git repo (no symlink into a repo, no ~).
# Startup refuses a home inside a repo or git working tree. Example: /Users/you/.friday
AGENT_HOME=/absolute/path/to/agent-home
LOG_LEVEL=info
# Optional overrides
# Anthropic model tiers (ids). Roles pick a tier: assistant haiku (escalates to sonnet/opus on request); dev sonnet, opus for class=design, haiku for mechanical
# MODEL_HAIKU=claude-haiku-4-5-20251001
# MODEL_SONNET=claude-sonnet-5-5
# MODEL_OPUS=claude-opus-5-5
# Pin one role (tier name or model id): MODEL_<ROLE>, e.g. MODEL_DEV=opus, MODEL_ASSISTANT=sonnet. An assistant pin disables answer escalation
# Budget per role run in USD: BUDGET_<ROLE>_USD. Defaults: ASSISTANT 1.0 (escalated 2.5), DEV 4.5
# BUDGET_DEV_USD=4.5
# MODEL is NO LONGER USED (startup warns if set): pin a role with MODEL_<ROLE> or the tier ids with MODEL_<TIER>. The old two-part names (MODEL_DEV_PLAN, BUDGET_DEV_EXEC_USD, ...) are ignored too.
# Model for the manual memory compaction call (`compact memory`, `bun run memory:compact`). Default: the haiku tier (MODEL_HAIKU)
# MEMORY_MODEL=claude-haiku-4-5-20251001
# Commit identity for agent commits when a repo has no gitAuthor in repos.yaml: "Name <email>"
# GIT_AUTHOR=Your Name <you@example.com>
# Auto-compact window (tokens) the app hands the SDK child per role: COMPACT_WINDOW_<ROLE>. Default for every role: 1000000 (the SDK caps it at the model window) with compaction at 75% of it. Valid: 0 (no window var, SDK default window; the 75% share still applies) or 100000-1000000, anything else fails startup. Never read from your shell: only this value reaches the child
# COMPACT_WINDOW_LEAD=1000000
# MAX_BUDGET_USD=   optional global cap = min(role budget, cap); unset = role budgets only
# TIMEOUT_MS=300000   only bounds the memory-compaction model call (agent runs have no timeout)
