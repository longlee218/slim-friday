# Friday env. Copy to .env and replace REPLACE_ME. Never commit real values.
# Bots never see these variables (packages/runtime-claude/src/floor/data/child-env-deny.yaml).

# --- Required ---------------------------------------------------------------
# Claude OAuth token from `claude setup-token` (no Anthropic API key needed).
CLAUDE_CODE_OAUTH_TOKEN=REPLACE_ME
# Agent home: absolute path to a REAL directory OUTSIDE every git repo (no symlink into a repo, no ~).
# Holds config/, data/ (engine.db, memory-index.db), memory/, scratch/, inbox/, trash/, logs/.
AGENT_HOME=/absolute/path/to/agent-home
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- Web app and API (required by `bun run start`) ---------------------------
# Hono listens on 127.0.0.1 only (API_PORT); the Cloudflare Tunnel points here.
API_PORT=8787
# The web app's origin: CORS, the Origin check and the passkey origin. A comma-separated list also
# allows a local dev web app (each origin signs in on its own; the first one owns passkeys and OAuth
# redirects): WEB_ORIGIN=https://friday.example.com,http://localhost:5173
WEB_ORIGIN=https://friday.example.com
# The tunnel hostname (same value as the web app's VITE_API_URL).
PUBLIC_API_URL=https://friday-api.example.com
# At least 32 chars, e.g. `openssl rand -base64 48`. Changing it signs out every device.
AUTH_SECRET=REPLACE_ME
# The one user. Never emailed: the sign-in link goes to <AGENT_HOME>/logs/owner-links.log.
OWNER_EMAIL=owner@example.com

# --- Cloudflare R2 (required) -------------------------------------------------
# A private bucket for the web app's files; an API token scoped to this bucket only
# (setup: docs/web-setup.md).
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET=friday-files
# Optional: a public custom domain on R2_BUCKET. Only images are served from it (other files stay
# presigned). Set the web app's VITE_CDN_ORIGIN to the same value.
# CDN=https://img.example.com

# --- Optional: memory provider (Honcho) --------------------------------------
# Turned on by <AGENT_HOME>/config/settings.yaml `memory.providers`, not by env (docs/honcho-setup.md).
# A local Honcho (localhost / private IP, scripts/setup-honcho.sh) needs no key.
# Set it only for a Honcho on another network (server with AUTH_USE_AUTH=true).
# HONCHO_API_KEY=

# --- Optional: Axiom log shipping --------------------------------------------
# Ids, status and timings only, never message text. Both needed.
# AXIOM_TOKEN=
# AXIOM_DATASET=

# --- Optional: values for external MCP servers --------------------------------
# A server in <AGENT_HOME>/config/mcp.yaml may use ${NAME}; it is read from here, and a server with a
# missing value is not started. Example (Firecrawl extension):
# FIRECRAWL_API_KEY=

# --- Optional: git identity for the effect tools -----------------------------
# Default: user.name / user.email of your global git config.
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
