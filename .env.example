# Placeholder values only. Copy to .env and replace REPLACE_ME. Never commit real values.
CLAUDE_CODE_OAUTH_TOKEN=REPLACE_ME
DISCORD_TOKEN=REPLACE_ME
OWNER_DISCORD_ID=REPLACE_ME
# Guild (server) id the bot serves: messages from any other guild are ignored. REQUIRED as soon as any
# workspace lists `channels:` in workspace.yaml (startup refuses without it). 17-20 digits.
DISCORD_GUILD_ID=REPLACE_ME
# Agent home: absolute path to a REAL directory OUTSIDE every git repo (no symlink into a repo, no ~).
# Startup refuses a home inside a repo or git working tree. Example: /Users/you/.friday
AGENT_HOME=/absolute/path/to/agent-home
LOG_LEVEL=info
# Optional overrides
# Models, budgets and compact windows are constants in each role file (src/roles/builtin/*); no env var changes them.
# Cheap model for the one-shot summary calls (rollover summary, attachment summary). Default: the Haiku summary model (not the Haiku 5.5 of the scout and discord-manager roles)
# MEMORY_MODEL=claude-haiku-4-5-20251001
# Commit identity for agent commits when a repo has no gitAuthor in repos.yaml: "Name <email>"
# GIT_AUTHOR=Your Name <you@example.com>
# MAX_BUDGET_USD=   optional global cap = min(role budget, cap); unset = role budgets only
# TIMEOUT_MS=300000   caps the one-shot summary calls (agent runs have no timeout)
# Firecrawl API key: connects the hosted Firecrawl MCP server (web search, scrape, paper index) to the scout.
# Unset = the scout uses WebSearch/WebFetch only. Never passed to an agent process.
# FIRECRAWL_API_KEY=
# Artifact viewer (src/viewer): read-only web page for artifacts behind a Cloudflare Tunnel, opened from an "Open" button.
# OFF unless BOTH VIEWER_SECRET and VIEWER_BASE_URL are set. Secret = HMAC key of the signed links (>= 32 bytes, e.g. `openssl rand -hex 32`);
# base URL = the tunnel's public address; the server listens on 127.0.0.1 only. Never passed to an agent process.
# VIEWER_SECRET=
# VIEWER_BASE_URL=https://viewer.example.com
# VIEWER_PORT=8787
# VIEWER_LINK_TTL_MS=604800000   signed link life, default 7 days
# Debug: FRIDAY_DUMP_PROMPTS=1 writes the exact system prompt, user prompt, tools and options of every model run to
# <AGENT_HOME>/logs/prompts/<time>-<role>-<thread>.md (mode 0600, secrets masked, newest 50 kept). Off by default.
# FRIDAY_DUMP_PROMPTS=1
# Temporary: FRIDAY_SANDBOX_OFF=1 runs dispatched workers WITHOUT the OS sandbox (their shell can write and read anywhere the
# bot's user can). Off by default = sandbox on.
# FRIDAY_SANDBOX_OFF=1
