# Friday env. Copy to .env and replace REPLACE_ME. Never commit real values.
# Bots never see these variables (packages/runtime-claude/src/floor/data/child-env-deny.yaml).

# --- Required ---------------------------------------------------------------
# Claude OAuth token from `claude setup-token` (no Anthropic API key needed).
CLAUDE_CODE_OAUTH_TOKEN=REPLACE_ME
# Agent home: absolute path to a REAL directory OUTSIDE every git repo (no symlink into a repo, no ~).
# Holds config/, data/ (engine.db, memory-index.db), memory/, scratch/, inbox/, trash/, logs/.
AGENT_HOME=/absolute/path/to/agent-home
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- Discord (required by `bun run start`) -----------------------------------
DISCORD_TOKEN=REPLACE_ME
# Your Discord user id: only your messages count.
OWNER_DISCORD_ID=REPLACE_ME
# The one guild (server) the bot serves, 17-20 digits.
DISCORD_GUILD_ID=REPLACE_ME

# --- Optional: web API -------------------------------------------------------
# Optional until the web app ships. Set all four or none (a partial set refuses to start).
# The API listens on 127.0.0.1 (API_PORT) behind a Cloudflare Tunnel.
# WEB_ORIGIN=https://friday.example.com
# PUBLIC_API_URL=https://friday-api.example.com
# AUTH_SECRET=REPLACE_ME_WITH_32_OR_MORE_RANDOM_CHARS
# OWNER_EMAIL=owner@example.com
# API_PORT=8787

# --- Optional: memory provider (Honcho) --------------------------------------
# Turned on by <AGENT_HOME>/config/settings.yaml `memory.providers`, not by env (docs/honcho-setup.md).
# A local Honcho (localhost / private IP, scripts/setup-honcho.sh) needs no key.
# Set it only for a Honcho on another network (server with AUTH_USE_AUTH=true).
# HONCHO_API_KEY=

# --- Optional: Axiom log shipping --------------------------------------------
# Ids, status and timings only, never message text. Both needed.
# AXIOM_TOKEN=
# AXIOM_DATASET=

# --- Optional: values for external MCP servers --------------------------------
# A server in <AGENT_HOME>/config/mcp.yaml may use ${NAME}; it is read from here, and a server with a
# missing value is not started. Example (Firecrawl extension):
# FIRECRAWL_API_KEY=

# --- Optional: git identity for the effect tools -----------------------------
# Default: user.name / user.email of your global git config.
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
