{
  "name": "friday-slim-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "db:generate:engine": "drizzle-kit generate --config packages/store-sqlite/drizzle.config.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src test packages apps",
    "lint": "biome check src test packages apps"
  },
  "dependencies": {
    "@friday/surface-discord": "workspace:*",
    "@friday/app": "workspace:*",
    "@friday/tools": "workspace:*",
    "@friday/config": "workspace:*",
    "@friday/store-sqlite": "workspace:*",
    "@friday/core": "workspace:*",
    "@friday/runtime-claude": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.295",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/mustache": "^4.2.6",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.4",
    "franc-min": "^6.2.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "mustache": "^4.2.0",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.2",
    "@types/markdown-it": "^14.2.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
