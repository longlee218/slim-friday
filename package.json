{
  "name": "friday-slim-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "bun run apps/friday/src/index.ts",
    "dev:api": "bun run start",
    "dev:web": "bun run --cwd apps/web dev",
    "dev": "trap 'kill 0' EXIT; bun run dev:api & bun run dev:web & wait",
    "db:generate:engine": "drizzle-kit generate --config packages/store-sqlite/drizzle.config.ts",
    "test": "bun test",
    "prepare": "lefthook install || true",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write test packages apps",
    "lint": "biome check test packages apps"
  },
  "dependencies": {
    "@friday/app": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.2",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2"
  }
}
